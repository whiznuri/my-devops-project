# 1. ดึงภาพพื้นหลังที่มี Node.js มาใช้งาน
FROM node:18-alpine

# 2. กำหนดโฟลเดอร์ทำงานภายในกล่อง
WORKDIR /app

# 3. ก๊อปปี้ไฟล์รายการอะไหล่ไปวางในกล่อง
COPY package*.json ./

# 4. สั่งติดตั้งอะไหล่ (Dependencies)
RUN npm install

# 5. ก๊อปปี้โค้ดทั้งหมดในเครื่องเราใส่เข้าไปในกล่อง
COPY . .

# 6. เปิดช่องทาง Port 3000 ให้ภายนอกคุยกับกล่องได้
EXPOSE 3000

# 7. คำสั่งสตาร์ทแอปเมื่อเปิดกล่อง
CMD ["node", "index.js"]